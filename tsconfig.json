{
  "compilerOptions": {
    "rootDir": ".",
    "esModuleInterop": true,
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": true,
    "downlevelIteration": true,
    "resolveJsonModule": true,
    "lib": ["es2022"],
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist/dts",
    "types": ["jest", "node"]
  },
  "exclude": ["dist"]
}
