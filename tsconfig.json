{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "lib": ["es6"],
    "allowJs": false,
    "outDir": "build",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false
  },
  "compileOnSave": false,
  "include": [
    "test/**/*.test.ts"
  ],
  "files": [
    "lib/index.ts"
  ]
}
