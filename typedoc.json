{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./lib/index.docs.ts"],
  "projectDocuments": [
    "./guides/index.md",
    "./guides/polarity-request.md",
    "./guides/cache.md",
    "./guides/testing.md"
  ],
  "outputs": [
    {
      "name": "html",
      "path": "./docs",
      "options": {
        "navigation": {
          "includeCategories": true,
          "includeGroups": true,
          "excludeReferences": false,
          "includeFolders": true
        }
      }
    }
  ]
}