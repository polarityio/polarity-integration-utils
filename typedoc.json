{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./lib/index.docs.ts"],
  "projectDocuments": ["./guides/*.md"],
  "outputs": [
    {
      "name": "html",
      "path": "./docs",
      "options": {
        "navigation": {
          "includeCategories": true,
          "includeGroups": true,
          "excludeReferences": false,
          "includeFolders": true
        }
      }
    }
  ]
}